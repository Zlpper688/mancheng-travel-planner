# ─────────────────────────────────────────────────────────────
# 漫城 环境变量（复制成 .env.local）
# 全部可选：一个都不配也能跑，只是数据源从「实时」退化成「本地 + 开放地图」。
# ─────────────────────────────────────────────────────────────

# 高德开放平台 Web 服务 Key（强烈推荐）
# 申请地址：https://console.amap.com/dev/key/app
# 服务平台请选择「Web服务」，不要选「Web端(JS API)」。
# 配置后重启 npm run dev，即可启用任意城市的真实商户、公交/地铁与驾车路线。
AMAP_KEY=

# 高德每日调用上限（本地保护，不是高德侧的配额）
# 基础搜索默认 200 次/天（个人认证 5000/月 ÷ 30 ≈ 167），基础 LBS 默认 4000 次/天。
# 到顶后接口返回「今天的实时搜索额度已经用完了」，第二天 0 点重置。
# AMAP_DAILY_SEARCH_BUDGET=200
# AMAP_DAILY_LBS_BUDGET=4000

# 本地图库取图策略：不设置 = 现状（含抓取所得图，仅限本地演示）
# MC_PHOTO_LIBRARY=licensed 时跳过没有明确许可的图，改走维基/高德
# MC_PHOTO_LIBRARY=licensed

# 关闭搜狗/360 现场找图（正式发布建议关）
# MC_LIVE_PHOTO=0

# 维基图片代理（默认 WordPress Photon，可直连维基媒体时设 PHOTO_PROXY=none）
# PHOTO_PROXY_BASE=
# PHOTO_PROXY=none

# 对话模型（OpenAI 兼容，可选；未配置时自动使用向导模式）
# 例：Agnes AI 国内站 https://api.agnes-ai.cn/v1，免费档模型 agnes-2.5-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 也接受 OPENAI_API_KEY / OPENAI_BASE_URL（上面两项为空时才会读）

# 运行时缓存根目录（默认 .cache/；函数计算环境会自动落到系统临时目录）
# MC_CACHE_ROOT=

# 演示预热包目录（默认优先用仓库里的 data/warm/plan-warm，没有才用 .cache/plan-warm）
# MC_WARM_DIR=

# 关掉「搜索命中城市名就后台预热排线」的投机行为（公网部署建议设 0）
# MC_PREFETCH=0

# 结构化日志开关（1=开，0=关；CI 和压测时关掉）
# MC_LOG=0

# 打印每单排线的耗时与缓存命中情况
# MC_TIMING=1

# 一次排线结束后打印完整体检报告
# PLAN_AUDIT=1

# 站点自己的对外地址（robots / sitemap / 分享链接用）
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
